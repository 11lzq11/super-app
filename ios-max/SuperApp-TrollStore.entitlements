<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ============================================================
	     SuperApp TrollStore 扩展权限（entitlements）
	     ============================================================
	     用途：通过 TrollStore 安装 SuperApp 时使用，让 App 在未越狱
	     的情况下获得沙盒外的能力，是 iOS 上 Super MAX 的权限基础。
	     ⚠️ 仅 TrollStore 安装有效；App Store / 正常侧载无法使用。
	     ⚠️ 不要全开：按需取用，每开一项都意味着更大的风险面。
	     逐项说明与风险见下方每条注释；完整指南见 ios-max/README.md。
	     使用方式：TrollStore 安装时选用自定义 entitlements，
	     或用 ldid 重新签名：ldid -S SuperApp-TrollStore.entitlements SuperApp
	     （均未验证，见 README）。
	     ============================================================ -->

	<!-- 应用标识（必需）。格式固定，不要改。 -->
	<key>application-identifier</key>
	<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>

	<!-- 以平台应用身份运行（必需，用于 MAX）。
	     用途：让 App 被系统视为平台级应用，绕过针对普通第三方应用的
	     部分限制，是无沙盒运行的前提之一。
	     风险：App 获得与系统应用相近的信任等级，一旦 App 本身有漏洞
	     或被植入恶意代码，影响远大于普通应用。 -->
	<key>platform-application</key>
	<true/>

	<!-- 关闭沙盒（必需，用于 MAX）。
	     用途：App 可读写沙盒外的文件（mobile 用户权限范围内），
	     WebOS 文件管理器、AiPlat 文件操作才能访问真实文件系统。
	     风险：最高危的一项。App 能读取照片、聊天记录、其他应用数据
	     等 mobile 用户可读的全部内容；有 bug 时也可能误删系统文件。 -->
	<key>com.apple.private.security.no-sandbox</key>
	<true/>

	<!-- 不强制要求应用容器（配合 no-sandbox）。
	     用途：App 不再被关进自己的容器目录，可直接访问 /var/mobile 等路径。
	     风险：与 no-sandbox 相同；容器隔离失效。 -->
	<key>com.apple.private.security.container-required</key>
	<false/>

	<!-- 允许其他进程获取本 App 的任务端口（建议开启，用于 MAX）。
	     用途：调试器、辅助工具、越狱插件与 App 做 IPC 时需要。
	     风险：其他进程可以检查、控制本 App 的内存与执行，恶意进程
	     可能借此窃取 App 内的数据（如 ApiPlat 里填的 API Key）。 -->
	<key>get-task-allow</key>
	<true/>

	<!-- 跳过动态库签名校验（建议开启，用于 MAX）。
	     用途：允许 App 加载未签名的 dylib，例如 SuperAppMax 插件的
	     辅助库，或用户自己编译的工具库。
	     风险：任意未签名代码都可被注入本 App 进程，等同于放弃了
	     代码签名这道防线。 -->
	<key>com.apple.private.skip-library-validation</key>
	<true/>

	<!-- 允许获取其他进程的任务端口（可选，用于 MAX 的系统级能力）。
	     用途：查看/管理系统进程信息，是“AI 调设置”、进程管理等
	     系统级功能的基础。
	     风险：可读取其他应用进程的内存；配合 get-task-allow 使用时
	     风险叠加。不需要进程管理功能时不要开。 -->
	<key>task_for_pid-allow</key>
	<true/>

	<!-- 绕过隐私权限弹窗（可选，高危，按需取用）。
	     用途：无需用户弹窗即可访问受 TCC 保护的数据。
	     下面的 kTCCServiceSystemPolicyAllFiles = 完全磁盘访问权限，
	     让 App 可以读 mobile 用户能读的全部文件；kTCCServicePhotos =
	     照片图库访问。
	     风险：极高。绕过了 iOS 最重要的隐私防线，用户不会收到任何
	     提示。只在确实需要时开启，且只保留用得到的服务；不要照抄。 -->
	<key>com.apple.private.tcc.allow</key>
	<array>
		<string>kTCCServiceSystemPolicyAllFiles</string>
		<string>kTCCServicePhotos</string>
	</array>

	<!-- 允许调用私有的 MobileInstallation SPI（可选，待验证）。
	     用途：安装/卸载/查询其他应用，是 WebOS 应用商店“装应用”
	     这类功能在 iOS 上落地的可能路径。
	     风险：App 可以不经用户确认安装、删除其他应用；SPI 名称与
	     行为可能随 iOS 版本变化，本条尚未在真机上验证过，见 README。
	     不需要应用管理功能时不要开。 -->
	<key>com.apple.private.mobileinstall.allowedSPI</key>
	<array>
		<string>Install</string>
		<string>Uninstall</string>
	</array>
</dict>
</plist>
